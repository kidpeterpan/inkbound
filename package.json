{
  "name": "inkbound",
  "version": "1.0.0",
  "private": true,
  "description": "Export notes, book folders, or linked notes as EPUB for e-ink readers, with optional wireless delivery to Onyx Boox.",
  "author": "kidpeterpan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kidpeterpan/obsidian-plugin-epub-export.git"
  },
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "deploy": "npm run build && bash scripts/deploy.sh",
    "epubcheck": "tsx scripts/build-sample.ts && if command -v epubcheck >/dev/null; then epubcheck sample.epub; else echo 'epubcheck not installed — brew install epubcheck to validate'; fi",
    "local-export": "tsx scripts/local-export.ts",
    "version:check": "tsx scripts/version.ts check",
    "version:bump": "tsx scripts/version.ts bump",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,tests,scripts}/**/*.ts\" \"*.{json,mjs,md}\"",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.ts\" \"*.{json,mjs,md}\""
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "jsdom": "^24.1.0",
    "marked": "^18.0.7",
    "obsidian": "^1.5.7",
    "prettier": "^3.9.6",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}
